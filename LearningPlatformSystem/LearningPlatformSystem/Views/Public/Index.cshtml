@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "RUST - Portal";
}
<!doctype html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS -->
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Assets/css/CustomStyles/landingpage.css" />
</head>
<body>



    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">

                <!-- Left Content -->
                <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-right">
                    <h1>جامعة الرواد للعلوم والتقانة - البوابة التعليمية</h1>
                    <p>منصة تابعة لجامعة الرواد تتيح إدارة العملية التعليمية، متابعة الطلبة، وتقديم المحتوى الأكاديمي بطريقة سلسة وحديثة.</p>
                        @* <p class="mb-4">...</p> *@
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Panel" asp-action="Index" class="btn btn-main mt-3">الدخول إلى المنصة</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-main mt-3">تسجيل الخروج</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-main mt-3">تسجيل الدخول إلى المنصة</a>
                    }
                </div>

                <!-- Right Options -->
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="card-option" onclick="location.href='@Url.Action("Login", "Account")'">
                                    <i class="bi bi-person-workspace"></i>
                                    <h5>بوابة الإدارة</h5>
                                    <p>إدارة النظام والمحتوى</p>
                            </div>
                        </div>

                        <div class="col-md-6 mb-4">
                            <div class="card-option" onclick="location.href='@Url.Action("Login", "Account")'">
                                <h5>بوابة الكادر تدريسي</h5>
                                    <i class="bi bi-mortarboard-fill"></i>                                    <p>إدارة الدورات والطلبة</p>
                            </div>
                        </div>
                            <div class="col-md-6 mb-4">
                                <div class="card-option" onclick="location.href='@Url.Action("Login", "Account")'">
                                    <h5>بوابة الطالب</h5>
                                    <i class="bi bi-mortarboard-fill"></i>                                    <p>إدارة الدورات والطلبة</p>
                                </div>
                            </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- JS -->
    <script src="~/publicthemeassets/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/publicthemeassets/assets/js/bootstrap.min.js"></script>
</body>
