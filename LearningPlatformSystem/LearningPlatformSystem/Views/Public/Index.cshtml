@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "بوابة RUST التعليمية";
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>بوابة RUST التعليمية</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS -->
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/bootstrap.min.css">

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: #f5f7fa;
        }

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, #1e1e1e, #2e7d32);
            color: white;
        }

        .card-option {
            background: white;
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            transition: 0.3s;
            cursor: pointer;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

            .card-option:hover {
                transform: translateY(-5px);
            }

        .btn-main {
            background: #2e7d32;
            color: white;
            border-radius: 8px;
            padding: 10px 20px;
        }

            .btn-main:hover {
                background: #256628;
                color: white;
            }
    </style>
</head>

<body>

    <section class="hero">
        <div class="container">

            <div class="row align-items-center">

                <!-- Left Content -->
                <div class="col-lg-6 text-center text-lg-right mb-5 mb-lg-0">
                    <img src="~/assets/images/logo.png" style="width:120px; margin-bottom:20px;" />

                    <h1 style="font-weight:700;">
                        بوابة RUST التعليمية
                    </h1>

                    <p style="margin-top:20px; line-height:1.8;">
                        منصة تعليمية متكاملة تابعة لجامعة الرواد
                        تتيح إدارة العملية التعليمية، متابعة الطلبة،
                        وتقديم المحتوى الأكاديمي بطريقة حديثة.
                    </p>

                    <p style="margin-top:10px; opacity:0.8;">

....                    </p>

                    @if (User.Identity.IsAuthenticated)
                    {

                        <a asp-controller="Panel" asp-action="Index" class="btn btn-main mt-3">
                            الدخول إلى المنصة
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-main mt-3">
                                تسجيل الخروج
                            </button>
                        </form>
                    }
                    else
                    {

                        <a asp-controller="Account" asp-action="Login" class="btn btn-main mt-3">
                            تسجيل الدخول الدخول إلى المنصة
                        </a>
                    }
                </div>

                <!-- Right Options -->
                <div class="col-lg-6">
                    <div class="row">

                        @* <!-- Student -->
                        <div class="col-md-4 mb-3">
                            <div class="card-option"
                                 onclick="location.href='@Url.Action("Login", "Account")'">
                                <h5>طالب</h5>
                                <p>الدخول لمتابعة الدروس والمواد</p>
                            </div>
                        </div> *@

                        <!-- Admin -->
                        <div class="col-md-4 mb-3">
                            <div class="card-option" style="background-color:greenyellow"
                                 onclick="location.href='@Url.Action("Login", "Account")'">
                                <h5>إدارة</h5>
								<img src="~/images/admin (2).png" width="20%"/>
                                <p>إدارة النظام والمحتوى</p>
                            </div>
                        </div>

                        @* <!-- Staff -->
                        <div class="col-md-4 mb-3">
                            <div class="card-option"
                                 onclick="location.href='@Url.Action("Login", "Account")'">
                                <h5>كادر تدريسي</h5>
                                <p>إدارة الدورات والطلبة</p>
                            </div>
                        </div> *@

                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- JS -->
    <script src="~/publicthemeassets/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/publicthemeassets/assets/js/bootstrap.min.js"></script>

</body>
</html>