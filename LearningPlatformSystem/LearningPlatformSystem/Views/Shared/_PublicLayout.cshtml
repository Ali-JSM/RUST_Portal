<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <link rel="icon" type="image/x-icon" href="~/assets/images\Logo\ICO\favicon-32x32 g+w.png"/>
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/bootstrap.min.css">
        <style>
                html, body {
                    height: 100%;
                    margin: 0;
                }

                body {
                    display: flex;
                    flex-direction: column;
                    min-height: 100vh;
                    margin: 0;
                    font-family: Arial, sans-serif;
                }

                /* Navbar */
                .navbar-custom {
                    position: fixed;
                    top: 0;
                    width: 100%;
                    z-index: 1000;
                    background: rgba(255, 255, 255, 0.85);
                    backdrop-filter: blur(10px);
                    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
                }

                /* Container */
                .nav-container {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 12px 40px;
                }

                /* Logo */
                .nav-logo img {
                    height: 45px; /* MUCH better than 3% */
                    transition: transform 0.3s ease;
                }

                    .nav-logo img:hover {
                        transform: scale(1.05);
                    }

                /* Links */
                .nav-links {
                    display: flex;
                    gap: 30px;
                }

                    .nav-links a {
                        text-decoration: none;
                        color: #222;
                        font-weight: 500;
                        position: relative;
                        transition: 0.3s;
                    }

                        /* Hover underline effect */
                        .nav-links a::after {
                            content: "";
                            position: absolute;
                            width: 0%;
                            height: 2px;
                            bottom: -5px;
                            right: 0;
                            background-color: #2e7d32; /* green */
                            transition: 0.3s;
                        }

                        .nav-links a:hover::after {
                            width: 100%;
                            left: 0;
                        }

                /* Button */
                .btn-login {
                    background: #2e7d32;
                    color: white;
                    padding: 8px 18px;
                    border-radius: 8px;
                    text-decoration: none;
                    transition: 0.3s;
                }

                    .btn-login:hover {
                        background: #256628;
                    }

                footer {
                    bottom: 0;
                    width: 100%;
                    background-color: #ffffff; /* White background */
                    color: #28a745; /* Green text */
                    text-align: center;
                    padding: 15px 10px;
                    border-top: 1px solid #ddd;
                    font-size: 18px;
                    position: fixed;
                    bottom: 0;
                    width: 100%;
                    height: 60px; /* define height */
                }

                    footer a {
                        color: #28a745;
                        text-decoration: none;
                    }

                        footer a:hover {
                            text-decoration: underline;
                        }
        </style>
    </head>
    <body>
        <header class="navbar-custom">
            <div class="nav-container">

                <!-- Logo -->
                <div class="nav-logo">
                    <img src="~/assets/images/Logo/PNG/main-logo.png" alt="RUST Logo" />
                </div>

                <!-- Navigation Links -->
                <nav class="nav-links">
                    <a href="#">الرئيسية</a>
                    <a href="#">المواد</a>
                    <a href="#">الأساتذة</a>
                    <a href="#">تواصل</a>
                </nav>

                <!-- Action Button -->
                <div class="nav-actions">
                    <a href="#" class="btn-login">تسجيل الدخول</a>
                </div>

            </div>
        </header>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        @await RenderSectionAsync("Scripts", required: false)
        <script src="~/publicthemeassets/assets/js/vendor/jquery-1.12.4.min.js"></script>
        <script src="~/publicthemeassets/assets/js/bootstrap.min.js"></script>

        <footer>
            جميع الحقوق محفوظة جامعة الرواد للعلوم والتقانة 2026 ©
        </footer>
    </body>
</html>