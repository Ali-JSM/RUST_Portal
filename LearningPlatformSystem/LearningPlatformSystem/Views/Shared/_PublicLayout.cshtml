@{
    var isLoginPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
            ViewContext.RouteData.Values["action"]?.ToString() == "Login";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <link rel="icon" type="image/x-icon" href="~/assets/images\Logo\ICO\favicon-32x32 g+w.png"/>
    <!-- CSS -->
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/Assets/css/CustomStyles/publiclayout.css" />
    </head>
    <body>
        <header class="navbar-custom">
            <div class="nav-container">

                <!-- Logo -->
                <div class="nav-logo">
                    <div class="nav-logo">
                        <img src="~/assets/images/Icons/PNG/main-logo.png" alt="RUST Logo" />
                        <a href="">جامعة الرواد للعلوم والتقانة</a>
                    </div>
                </div>

                <!-- Links -->
                <nav class="nav-links">
                    <a href="">الرئيسية</a>
                    <a href="">المواد</a>
                    <a href="">الأساتذة</a>
                    <a href="">تواصل</a>

                </nav>
                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-main mt-3">تسجيل الخروج</button>
                    </form>
                }
                else
                {
                    <!-- Actions (IMPORTANT wrapper) -->
                    <div class="nav-actions">
                        @if (!isLoginPage)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-login">تسجيل الدخول إلى المنصة</a>
                        }
                    </div>

                    if (!@isLoginPage)
                    {
                    }
                }
            </div>
        </header>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        @await RenderSectionAsync("Scripts", required: false)
        <script src="~/publicthemeassets/assets/js/vendor/jquery-1.12.4.min.js"></script>
        <script src="~/publicthemeassets/assets/js/bootstrap.min.js"></script>

        <footer>
            جميع الحقوق محفوظة جامعة الرواد للعلوم والتقانة 2026 ©
        </footer>
    </body>
</html>
<script src="~/assets/js/customscripts/pagemethds.js"></script>