<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <link rel="icon" type="image/x-icon" href="~/assets/images\Logo\ICO\favicon-32x32 g+w.png"/>
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/bootstrap.min.css">
        <style>
                html, body {
                    height: 100%;
                    margin: 0;
                }

                body {
                    display: flex;
                    flex-direction: column;
                    min-height: 100vh;
                    margin: 0;
                    font-family: Arial, sans-serif;
                }

      

                footer {
                    bottom: 0;
                    width: 100%;
                    background-color: #ffffff; /* White background */
                    color: #28a745; /* Green text */
                    text-align: center;
                    padding: 15px 10px;
                    border-top: 1px solid #ddd;
                    font-size: 18px;
                    position: fixed;
                    bottom: 0;
                    width: 100%;
                    height: 60px; /* define height */
                }

                    footer a {
                        color: #28a745;
                        text-decoration: none;
                    }

                        footer a:hover {
                            text-decoration: underline;
                        }
        </style>
    </head>
    <body>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        @await RenderSectionAsync("Scripts", required: false)
        <script src="~/publicthemeassets/assets/js/vendor/jquery-1.12.4.min.js"></script>
        <script src="~/publicthemeassets/assets/js/bootstrap.min.js"></script>

        <footer>
            جميع الحقوق محفوظة جامعة الرواد للعلوم والتقانة 2026 ©
        </footer>
    </body>
</html>