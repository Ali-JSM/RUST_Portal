@{
    ViewData["Title"] = "RUST - Portal\\";
}
<!DOCTYPE html>
<html lang="En">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="icon" type="image/x-icon" href="~/assets/images\Logo\ICO\favicon-32x32 g+w.png" />
    <title>@ViewData["Title"]</title>
    @* // ايوقونات بوت ستراب *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!-- fonts--!>
    <link href="~/Assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
    rel="stylesheet">
    @* <!-- الستايل الرئيسي يتم التحديث عبر الوقت وتغير اسم الملف لكي cache لايحفظه *@
    <link href="~/Assets/css/sb-admin-2.css?v=@DateTime.Now.Ticks" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-controller="Panel" asp-action="Index">
                <div class="sidebar-brand-icon rotate-n-15">
                    @* هذه الصورة يجب انن تتغير بين ادمن ومستخدم *@
                    @* @if (User.IsInRole("Admin"))
                    {
                        <img  src="~/assets/images/buttons/Admin (3).png" />
                    } *@
						<img width="80%" src="~/assets/images/logo.png" / >
                </div>
                <div class="sidebar-brand-text mx-3">RUST Portal <sup>Ali GT</sup></div>
            </a>
            <hr class="sidebar-divider my-0">
            <li class="nav-item active">
                <a class="nav-link" asp-controller="Panel" asp-action="Index">
                                <i class="bi bi-person-circle"></i>                    @if (User.IsInRole("Admin"))
                    {
                        <span>لوحة التحكم - الصفحة الرئيسية</span>
                    }

                </a>
            </li>
                                                                 <hr class="sidebar-divider d-none d-md-block">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Enrollment" asp-action="PendingRequests">
                                <i class="bi bi-pass"></i>                                <span>الطلبات الجارية
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="yellow" class="bi bi-bell-fill" viewBox="0 0 16 16">
                                        <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2m.995-14.901a1 1 0 1 0-1.99 0A5 5 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901"/>
                                    </svg>
                                </span>
                            </a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link" asp-controller="Enrollment" asp-action="AllRequests" class="btn btn-secondary">
        <i class="bi bi-check-all"></i>
        <span>جميع الطلبات</span>

                                </a>

                   </li>

            <hr class="sidebar-divider">

            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseData" 
                aria-expanded="true" aria-controls="collapseUtilities">
                    <i class="bi bi-database"></i>
                    <span>عرض البيانات</span>
                </a>
                        <div id="collapseData" class="collapse" aria-labelledby="headingUtilities"
                data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-controller="Courses" asp-action="Index">جميع المواد</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                        {
                        <a class="collapse-item" asp-controller="Tutors" asp-action="Index">جميع المدرسين</a>
                            <a class="collapse-item" asp-controller="Learners" asp-action="Index">جميع الطلاب</a>
                        }
                    </div>
                    </div>
                    </li>      
                    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
            {
                <li class="nav-item">
                            <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseDataEntry"
                    aria-expanded="true" aria-controls="collapseTwo">
                        <i class="bi bi-database-add"></i>
                        <span>إدخال البيانات</span>
                    </a>
                            <div id="collapseDataEntry" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <a class="collapse-item" asp-controller="Courses" asp-action="Create">إدخال مادة جديدة</a>
                            <a class="collapse-item" asp-controller="Tutors" asp-action="Create">إدخال مدرس جديد</a>
                            <a class="collapse-item" asp-controller="Learners" asp-action="Create">إدخال طالب جديد</a>
                                        @if (User.IsInRole("Admin")){
                            }
                        </div>
                    </div>
                </li>
            }
                <hr class="sidebar-divider">
            @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
            {
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseAdminAffairs"
                    aria-expanded="true" aria-controls="collapsePages">
                                <i class="bi bi-person-fill-gear"></i>
                                <span>الأدوات الإدارية</span>
                    </a>
                            <div id="collapseAdminAffairs" class="collapse" aria-labelledby="headingPages" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <a class="collapse-item" asp-controller="Panel" asp-action="UsersDetails">جميع المستخدمين</a>
                                  @if (User.IsInRole("Admin")){
                                    <a class="collapse-item" asp-controller="Panel" asp-action="CreateUser">إتشاء مستخدم جديد</a>
                                            <a class="collapse-item" asp-controller="Panel" asp-action="ManageEnrollments">تسجيل الطلاب على المواد</a>
                                            }

                        </div>
                    </div>
                            </li>
                            <li class="nav-item">
                            <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseStudentAffairs"
                                       aria-expanded="true" aria-controls="collapsePages">
                                <i class="bi bi-lock-fill"></i>
                                <i class="bi bi-mortarboard"></i>
                                <span>شؤون الطلاب</span>
                                </a>
                            <div id="collapseStudentAffairs" class="collapse" aria-labelledby="headingPages" data-parent="#accordionSidebar">
                                    <div class="bg-white py-2 collapse-inner rounded">
                                                                            <p>قريباً ادوات ادارة شؤون الطلاب</p>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseHR"
                                       aria-expanded="true" aria-controls="collapsePages">
                                <i class="bi bi-lock-fill"></i>
                                <i class="bi bi-person-lines-fill"></i>
                                <span>الموارد البشرية</span>
                                </a>
                            <div id="collapseHR" class="collapse" aria-labelledby="headingPages" data-parent="#accordionSidebar">
                                    <div class="bg-white py-2 collapse-inner rounded">
                                                                             <span>قريباً ادوات ادارة الموارد البشرية</span>
                                    </div>
                                </div>
                            </li>
                        <li class="nav-item" >
                                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseExams"
                                       aria-expanded="true" aria-controls="collapsePages">
                                <i class="bi bi-lock-fill"></i>
                                <i class="bi bi-journals"></i>
                                <span>إدارة الإمتحانات</span>
                                </a>
                            <div id="collapseExams" class="collapse" aria-labelledby="headingPages" data-parent="#accordionSidebar">
                                    <div class="bg-white py-2 collapse-inner rounded">
                                  
                                    <span>قريباً ادوات ادارة الإمتحانات</span>
                                    </div>
                                </div>
                            </li>
                }

            @if (User.IsInRole("Learner"))
            {
                                                    <hr class="sidebar-divider d-none d-md-block">
                       <li class="nav-item">
                                <a class="nav-link" asp-controller="Panel" asp-action="MyEnrollmentStatus">    <i class="bi bi-check-circle"></i>
                            <span>طلبات التسجيل خاصتي</span></a>
            </li>
            <li class="nav-item">
                        <a class="nav-link" asp-controller="Panel" asp-action="MyCourses">
                    <i class="bi bi-journal-bookmark"></i>
                    <span>موادي</span>
                </a>
            </li>
            }
                <hr class="sidebar-divider d-none d-md-block">
                <div class="text-center d-none d-md-inline">
                    <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
                     <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()

                                                                <button type="submit" class="nav-link btn btn-link"><i class="bi bi-box-arrow-left"></i>    <span>تسجيل الخروج</span></button>
                                                        </form>   
                    </a>
                </li>
        </ul>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                </nav>
                <div class="container-fluid">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Assets/vendor/jquery/jquery.min.js"></script>
    <script src="~/Assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Assets/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Assets/js/sb-admin-2.min.js"></script>
    <script src="~/Assets/vendor/chart.js/Chart.min.js"></script>
    <script src="~/Assets/js/demo/chart-area-demo.js"></script>
    <script src="~/Assets/js/demo/chart-pie-demo.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
