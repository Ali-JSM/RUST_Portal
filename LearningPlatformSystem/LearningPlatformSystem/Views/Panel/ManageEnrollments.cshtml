@model LearningPlatformSystem.Models.CoreModels.EnrollmentView

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["WarningMessage"]
    </div>
}
<h2>Manage Course Enrollments</h2>

<div class="row">
    <div class="col-md-6">
        <h4>Enroll Learner</h4>
        <form asp-action="EnrollLearner" method="post">
            <div class="form-group">
                <label>Course</label>
                <select asp-for="SelectedCourseId" class="form-control"
                        asp-items="@(new SelectList(Model.AvailableCourses, "CourseCode", "Title"))">
                    <option value="">-- Select Course --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Learner</label>
                <select asp-for="SelectedLearnerId" class="form-control"
                        asp-items="@(new SelectList(Model.AvailableLearners, "LearnerId", "FullName"))">
                    <option value="">-- Select Learner --</option>
                </select>
            </div>
            <div asp-validation-summary="All">
                
            </div>
            <button type="submit" class="btn btn-primary">Enroll</button>
        </form>
    </div>
</div>

<hr />

<h4>Current Enrollments</h4>
<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Learner</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var enrollment in Model.CurrentEnrollments)
        {
            <tr>
                <td>@enrollment.CourseTitle</td>
                <td>@enrollment.LearnerName</td>
                <td>
                    <form asp-action="RemoveEnrollment" method="post">
                        <input type="hidden" name="courseId" value="@enrollment.CourseId" />
                        <input type="hidden" name="learnerId" value="@enrollment.LearnerId" />
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Remove this enrollment?')">
                            Remove
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>