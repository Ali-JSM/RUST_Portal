@model List<LearningPlatformSystem.Models.TableModels.AwardedCertificate>
@{
    ViewData["Title"] = "My Certificates";
}

<div class="container py-5">
    <h1 class="mb-4">My Achievements</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No certificates yet!</h4>
            <p>Complete courses to earn certificates. Your achievements will appear here.</p>
            <a class="btn btn-primary" asp-controller="Courses" asp-action="Index">Browse Courses</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var cert in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">@cert.Course.Title</h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-4">
                                <i class="fas fa-award fa-4x text-warning"></i>
                            </div>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item">
                                    <strong>Issued:</strong>
                                    @cert.AwardDate.ToString("MMMM dd, yyyy")
                                </li>
                                <li class="list-group-item">
                                    <strong>Certificate ID:</strong>
                                    @cert.CertificateSerialCode
                                </li>
                                <li class="list-group-item">
                                    <strong>Course:</strong>
                                    @cert.Course.Category
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white text-center">
                            <button class="btn btn-outline-primary me-2">
                                <i class="fas fa-download me-1"></i> Download
                            </button>
                            <button class="btn btn-primary">
                                <i class="fas fa-share-alt me-1"></i> Share
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>