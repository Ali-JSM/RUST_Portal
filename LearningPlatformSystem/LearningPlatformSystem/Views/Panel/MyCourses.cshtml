@model List<LearningPlatformSystem.Models.TableModels.Course>
@{
    ViewData["Title"] = "My Courses";
}

<div class="container py-5">
    <h1 class="mb-4">My Learning Journey</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No courses yet!</h4>
            <p>You haven't enrolled in any courses. Browse our catalog to get started.</p>
            <a class="btn btn-primary" asp-controller="Courses" asp-action="Index">Explore Courses</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var course in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-img-top bg-light" style="height: 160px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-book-open fa-3x text-primary"></i>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@course.Title</h5>
                            <p class="card-text text-muted">@(course.Description?.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-info">@course.Category</span>
                                <span class="text-muted">@course.Hours hours</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseCode"
                               class="btn btn-outline-primary w-100 mb-2">
                                Continue Learning
                            </a>
                            <form asp-controller="Panel" asp-action="Unenroll" method="post">
                                <input type="hidden" name="courseId" value="@course.CourseCode" />
                                <button type="submit" class="btn btn-danger w-100"
                                        onclick="return confirm('Are you sure you want to unenroll from this course?')">
                                    Unenroll
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>