@using LearningPlatformSystem.Models.CoreModels
@model Login
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "منصة تعليمية مجانية- تسجيل الدخول";
}
<main class="login-body d-flex" style="min-height:100vh;">

    <!-- Left Side (Branding) -->
    <div class="d-none d-lg-flex flex-column justify-content-center align-items-center text-white"
         style="width:50%; background: linear-gradient(135deg,#1e1e1e,#2e7d32); padding:40px;">

        <img src="~/assets/images/logo.png" style="width:120px; margin-bottom:20px;" />

        <h2 style="font-weight:700;">منصة RUST التعليمية</h2>

        <p style="text-align:center; max-width:400px; margin-top:20px; line-height:1.8;">
            ضع كلام عن جامعة الرواد سوف اعدلها لاحقاً
        </p>

        <div style="margin-top:30px; font-size:14px; opacity:0.8;">
            مسارات حضارية ورؤية مستدامة
        </div>
    </div>

    <!-- Right Side (Login Form) -->
    <div class="d-flex justify-content-center align-items-center"
         style="width:100%; max-width:500px; margin:auto;">

        <form class="form-default w-100" asp-action="Login" method="post"
              style="padding:40px; background:white; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.1);">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Logo -->
            <div class="text-center mb-4">
                <img src="~/assets/images/logo.png" style="width:80px;" />
                <h4 class="mt-2">تسجيل الدخول</h4>
            </div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label asp-for="Email">البريد الإلكتروني</label>
                <input asp-for="Email" class="form-control" placeholder="example@email.com">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="form-group mb-3">
                <label asp-for="Password">كلمة المرور</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="********">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Remember -->
            <div class="form-group mb-3">
                <label>
                    <input asp-for="RememberMe" />
                    تذكرني
                </label>
            </div>

            <!-- Submit -->
            <div class="form-group">
                <button type="submit" class="btn w-100"
                        style="background:#2e7d32; color:white; padding:10px; border-radius:8px;">
                    تسجيل الدخول
                </button>
            </div>

            <!-- Register -->
            <div class="text-center mt-3">
                <a asp-controller="Public" asp-action="CreateUser">
                    لا تملك حساب؟ إنشاء حساب جديد
                </a>
            </div>

        </form>
    </div>

</main>