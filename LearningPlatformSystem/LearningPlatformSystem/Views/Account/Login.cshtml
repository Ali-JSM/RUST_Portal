@using LearningPlatformSystem.Models.CoreModels
@model Login
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "منصة تعليمية مجانية- تسجيل الدخول";
}
<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="manifest" href="site.webmanifest">
    <link rel="shortcut icon" type="image/x-icon" href="assets/img/favicon.ico">

    <!-- CSS here -->
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/slicknav.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/progressbar_barfiller.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/gijgo.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/animate.min.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/animated-headline.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/themify-icons.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/slick.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/nice-select.css">
    <link rel="stylesheet" href="~/publicthemeassets/assets/css/style.css">
</head>
<body>
    <!-- ? Preloader Start -->
    <div id="preloader-active">
        <div class="preloader d-flex align-items-center justify-content-center">
            <div class="preloader-inner position-relative">
                <div class="preloader-circle"></div>
				<div class="preloader-img pere-text">
					<img src="~/assets/images/logo.png" />
                </div>
            </div>
        </div>
    </div>
    <!-- Preloader Start-->


	<main class="login-body" style="background-color:#292929">
        <form class="form-default" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="login-form">
                <!-- logo-login -->
                <div class="logo-login">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/assets/images/logo.png" />
                    </a>
                </div>

                <h2>Login Here</h2>

                <div class="form-input">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" placeholder="Email">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-input">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="Password">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-input">
                    <label asp-for="RememberMe">
                        <input asp-for="RememberMe" />
                        @Html.DisplayNameFor(m => m.RememberMe)
                    </label>
                </div>

                <div class="form-input pt-30">
                    <input type="submit" value="Login">
                </div>


                <a asp-controller="Public" asp-action="CreateUser" class="registration">لاتمتلك حساب مسبقاً؟ سجل من جديد</a>
            </div>
        </form>
   
    </main>


    <script src="~/publicthemeassets/assets/js/vendor/modernizr-3.5.0.min.js"></script>
    <!-- Jquery, Popper, Bootstrap -->
    <script src="~/publicthemeassets/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/publicthemeassets/assets/js/popper.min.js"></script>
    <script src="~/publicthemeassets/assets/js/bootstrap.min.js"></script>
    <!-- Jquery Mobile Menu -->
    <script src="~/publicthemeassets/assets/js/jquery.slicknav.min.js"></script>

    <!-- Video bg -->
    <script src="~/publicthemeassets/assets/js/jquery.vide.js"></script>

    <!-- Jquery Slick , Owl-Carousel Plugins -->
    <script src="~/publicthemeassets/assets/js/owl.carousel.min.js"></script>
    <script src="~/publicthemeassets/assets/js/slick.min.js"></script>
    <!-- One Page, Animated-HeadLin -->
    <script src="~/publicthemeassets/assets/js/wow.min.js"></script>
    <script src="~/publicthemeassets/assets/js/animated.headline.js"></script>
    <script src="~/publicthemeassets/assets/js/jquery.magnific-popup.js"></script>

    <!-- Date Picker -->
    <script src="~/publicthemeassets/assets/js/gijgo.min.js"></script>
    <!-- Nice-select, sticky -->
    <script src="~/publicthemeassets/assets/js/jquery.nice-select.min.js"></script>
    <script src="~/publicthemeassets/assets/js/jquery.sticky.js"></script>
    <!-- Progress -->
    <script src="~/publicthemeassets/assets/js/jquery.barfiller.js"></script>

    <!-- counter , waypoint,Hover Direction -->
    <script src="~/publicthemeassets/assets/js/jquery.counterup.min.js"></script>
    <script src="~/publicthemeassets/assets/js/waypoints.min.js"></script>
    <script src="~/publicthemeassets/assets/js/jquery.countdown.min.js"></script>
    <script src="~/publicthemeassets/assets/js/hover-direction-snake.min.js"></script>

    <!-- contact js -->
    <script src="~/publicthemeassets/assets/js/contact.js"></script>
    <script src="~/publicthemeassets/assets/js/jquery.form.js"></script>
    <script src="~/publicthemeassets/assets/js/jquery.validate.min.js"></script>
    <script src="~/publicthemeassets/assets/js/mail-script.js"></script>
    <script src="~/publicthemeassets/assets/js/jquery.ajaxchimp.min.js"></script>

    <!-- Jquery Plugins, main Jquery -->
    <script src="~/publicthemeassets/assets/js/plugins.js"></script>
    <script src="~/publicthemeassets/assets/js/main.js"></script>

</body>
</html>