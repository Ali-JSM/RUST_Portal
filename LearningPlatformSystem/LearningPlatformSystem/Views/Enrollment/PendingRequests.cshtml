@model List<LearningPlatformSystem.Models.CoreModels.EnrollmentRequest>

@{
    ViewData["Title"] = "Pending Enrollment Requests";
}

<h2>Pending Enrollment Requests</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Learner</th>
            <th>Request Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.Course.Title</td>
                <td>@($"{request.Learner.FirstName} {request.Learner.LastName}")</td>
                <td>@request.RequestDate.ToString("d")</td>
                <td>
                    <div class="btn-group" role="group">
                        <form asp-action="ApproveRequest" method="post" class="me-2">
                            <input type="hidden" name="requestId" value="@request.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>

                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@request.Id">
                            Reject
                        </button>
                        <div class="modal fade" id="rejectModal-@request.Id" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="rejectModalLabel">Reject Enrollment Request</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-action="RejectRequest" method="post" id="rejectForm-@request.Id">
                                        <div class="modal-body">
                                            <input type="hidden" name="requestId" value="@request.Id" />
                                            <div class="mb-3">
                                                <label for="rejectionReason-@request.Id" class="form-label">Reason for rejection (optional):</label>
                                                <textarea class="form-control" id="rejectionReason-@request.Id" name="rejectionReason" rows="3"></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger">Confirm Reject</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        document.querySelectorAll('form[action*="ApproveRequest"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                if (!confirm('Are you sure you want to approve this enrollment request?')) {
                    e.preventDefault();
                }
            });
        });

        document.querySelectorAll('[id^="rejectForm"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                if (!confirm('Are you sure you want to reject this enrollment request?')) {
                    e.preventDefault();
                } else {
                    const submitBtn = form.querySelector('button[type="submit"]');
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';
                }
            });
        });
    </script>
}