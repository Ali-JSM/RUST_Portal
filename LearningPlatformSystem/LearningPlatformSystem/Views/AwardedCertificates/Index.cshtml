@using LearningPlatformSystem.Models.TableModels
@model IEnumerable<AwardedCertificate>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
    {
        <a asp-action="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AwardDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Learner)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Course)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AwardDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Learner.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Course.Title)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.CertificateSerialCode">Details</a>
                    @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.CertificateSerialCode">Edit</a>

                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.CertificateSerialCode">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
