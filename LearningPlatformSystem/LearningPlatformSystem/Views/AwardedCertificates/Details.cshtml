@using LearningPlatformSystem.Models.TableModels
@model AwardedCertificate

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>AwardedCertificate</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AwardDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AwardDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Learner)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Learner.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Course)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Course.Title)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.CertificateSerialCode">Edit</a>
    }
  |
    <a asp-action="Index">Back to List</a>
</div>
